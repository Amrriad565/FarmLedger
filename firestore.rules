rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these two accounts can read or write the shared ledger
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['amrriad565@gmail.com'];
    }
    match /entries/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['in', 'out'];
    }
  }
}
